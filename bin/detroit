#!/usr/bin/env bash
set -uo pipefail

DETROIT_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
TASKS="${DETROIT_TASKS:-$DETROIT_HOME/tasks}"
STATE="${DETROIT_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/detroit}"
PROJECTS="${DETROIT_PROJECTS:-$HOME/Projects}"
LESSONS="${DETROIT_LESSONS:-$DETROIT_HOME/lessons.md}"
AGENT="${DETROIT_AGENT:-grok}"
OPENCODE_MODEL="studio/mlx-community/Qwen3-Coder-Next-4bit"
TASK_LOCK=""
SHIFT_LOCK=""
LINES="$STATE/lines"

usage() {
  cat << 'EOF'
usage: detroit <command> [args]

  run                 take the next task: setup, plan, code, done
  shift [--hours N] [--parallel N]
                      run tasks until the queue is empty or N hours pass (default 6), N at a time (default 1)
  add "text"          write a task into tasks/ (--repo <name|owner/name|path>, --name <slug>)
  status [--json]     the queue, what is running, the last results
  dash [--web]        a live view of every line (--web serves it on 127.0.0.1:8787, --port N, --interval N, --once)
  install             start a nightly shift at 01:00 (systemd user timer)
  uninstall           stop the nightly shift
  help                this text

Settings (environment): DETROIT_AGENT (grok, claude or opencode), DETROIT_MODEL,
DETROIT_PROJECTS, DETROIT_SHIFT_HOURS, DETROIT_PARALLEL, DETROIT_CODE_TIMEOUT, DETROIT_STALL_SECS, DETROIT_RETRIES,
DETROIT_APPROVE_PLAN=1
EOF
}

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" | tee -a "$STATE/detroit.log"; }

init() { mkdir -p "$STATE/locks" "$STATE/lines" "$STATE/logs" "$STATE/plans" "$TASKS/done" "$TASKS/failed"; }

slug() { printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '-' | sed 's/--*/-/g;s/^-//;s/-$//' | cut -c1-40; }

front() {
  awk -v k="$2" 'NR == 1 && $0 != "---" { exit } NR > 1 && $0 == "---" { exit }
    NR > 1 { i = index($0, ":"); if (i && substr($0, 1, i - 1) == k) { v = substr($0, i + 1); sub(/^ +/, "", v); print v; exit } }' "$1"
}

body() { awk 'NR == 1 && $0 == "---" { f = 1; next } f && $0 == "---" { f = 0; next } !f' "$1"; }

lock_take() {
  local dir="$1" pid
  if ! mkdir "$dir" 2> /dev/null; then
    pid="$(cat "$dir/pid" 2> /dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2> /dev/null; then return 1; fi
    rm -rf "$dir"
    mkdir "$dir" 2> /dev/null || return 1
  fi
  printf '%s\n' "$$" > "$dir/pid"
}

line_write() {
  [ -n "${TASK_NAME:-}" ] || return 0
  printf 'task=%s\nrepo=%s\nphase=%s\nbranch=%s\nattempt=%s\nstarted=%s\nactivity=%s\npid=%s\n' \
    "$TASK_NAME" "$(basename "${REPO_DIR:-}")" "${LINE_PHASE:-}" "${BRANCH:-}" "${LINE_ATTEMPT:-1}" "${LINE_STARTED:-}" "${LINE_ACTIVITY:-}" "$BASHPID" > "$LINES/$TASK_NAME.tmp" &&
    mv "$LINES/$TASK_NAME.tmp" "$LINES/$TASK_NAME"
}

phase() {
  LINE_PHASE="$1"
  line_write
}

release() {
  [ -n "${TASK_NAME:-}" ] && rm -f "$LINES/$TASK_NAME" "$LINES/$TASK_NAME.tmp"
  [ -n "$TASK_LOCK" ] && rm -rf "$TASK_LOCK"
  [ -n "$SHIFT_LOCK" ] && rm -rf "$SHIFT_LOCK"
  TASK_LOCK=""
  SHIFT_LOCK=""
}

pick_task() {
  local f name
  while IFS= read -r f; do
    name="$(basename "$f" .md)"
    if lock_take "$STATE/locks/$name"; then
      if [ -f "$f" ]; then
        TASK_FILE="$f"
        TASK_NAME="$name"
        TASK_LOCK="$STATE/locks/$name"
        return 0
      fi
      rm -rf "$STATE/locks/$name"
    fi
  done < <(find "$TASKS" -maxdepth 1 -name '*.md' -type f | sort)
  return 1
}

preflight() {
  command -v gh > /dev/null || { log "gh is not installed. Install it and run gh auth login."; return 1; }
  gh auth status > /dev/null 2>&1 || { log "gh is signed out. Run gh auth login."; return 1; }
  [ -n "${DETROIT_AGENT_CMD:-}" ] || command -v "$AGENT" > /dev/null || { log "agent '$AGENT' is not installed. Set DETROIT_AGENT to grok, claude or opencode."; return 1; }
}

agent_argv() {
  local prompt="$1" model="${DETROIT_MODEL:-}"
  ARGV=()
  if [ -n "${DETROIT_AGENT_CMD:-}" ]; then
    ARGV=("$DETROIT_AGENT_CMD" "$prompt")
    return 0
  fi
  case "$AGENT" in
    claude) ARGV=(claude -p "$prompt" --dangerously-skip-permissions ${model:+--model "$model"}) ;;
    grok) ARGV=(grok --no-auto-update -p "$prompt" ${model:+--model "$model"}) ;;
    opencode) ARGV=(opencode run --auto -m "${model:-$OPENCODE_MODEL}" -- "$prompt") ;;
    *) return 1 ;;
  esac
}

activity_mtime() {
  local log newest
  log="$(stat -c %Y "$TASK_LOG" 2> /dev/null || echo 0)"
  newest="$(find "$WORK" \( -name node_modules -o -name target \) -prune -o -type f -printf '%T@\n' 2> /dev/null | sort -n | tail -1)"
  newest="${newest%.*}"
  [ "${newest:-0}" -gt "$log" ] && log="$newest"
  printf '%s\n' "$log"
}

watch_agent() {
  local pid="$1" tick=0 every="${DETROIT_WATCH_EVERY:-30}" stall="${DETROIT_STALL_SECS:-900}" start last now
  start="$(date +%s)"
  while kill -0 "$pid" 2> /dev/null; do
    sleep 0.2
    tick=$((tick + 1))
    [ $((tick % (every * 5))) = 0 ] || continue
    kill -0 "$pid" 2> /dev/null || break
    last="$(activity_mtime)"
    [ "$last" -lt "$start" ] && last="$start"
    now="$(date +%s)"
    LINE_ACTIVITY="$last"
    line_write
    if [ $((now - last)) -ge "$stall" ]; then
      log "stalled: $TASK_NAME had no activity for $((now - last))s"
      kill -TERM -- "-$pid" 2> /dev/null
      sleep 2
      kill -KILL -- "-$pid" 2> /dev/null
      return 125
    fi
  done
  return 0
}

run_agent() {
  local secs="$1" prompt="$2" pid rc w
  agent_argv "$prompt" || { log "unknown agent '$AGENT'. Set DETROIT_AGENT to grok, claude or opencode."; return 1; }
  (cd "$WORK" && exec setsid timeout -k 30 "$secs" "${ARGV[@]}" < /dev/null >> "$TASK_LOG" 2>&1) &
  pid=$!
  watch_agent "$pid"
  rc=$?
  wait "$pid" 2> /dev/null
  w=$?
  [ "$rc" = 125 ] && return 125
  return "$w"
}

setup() {
  local ref base start
  ref="$(front "$TASK_FILE" repo)"
  TASK_BODY="$(body "$TASK_FILE")"
  if [ -z "$ref" ]; then
    local name
    name="$(slug "$TASK_NAME")"
    REPO_DIR="$PROJECTS/$name"
    if [ ! -d "$REPO_DIR/.git" ]; then
      mkdir -p "$REPO_DIR" && git -C "$REPO_DIR" init -q -b main && git -C "$REPO_DIR" commit -q --allow-empty -m "Initial commit" || return 1
      (cd "$REPO_DIR" && gh repo create "$name" --private --source=. --push > /dev/null) || return 1
    fi
  else
    case "$ref" in
      /* | "~"*) REPO_DIR="${ref/#\~/$HOME}" ;;
      */*)
        REPO_DIR="$PROJECTS/${ref##*/}"
        [ -d "$REPO_DIR/.git" ] || gh repo clone "$ref" "$REPO_DIR" > /dev/null || return 1
        ;;
      *) REPO_DIR="$PROJECTS/$ref" ;;
    esac
    [ -d "$REPO_DIR/.git" ] || { log "no repo at $REPO_DIR"; return 1; }
  fi
  base="$(git -C "$REPO_DIR" symbolic-ref --short refs/remotes/origin/HEAD 2> /dev/null)"
  BASE="${base#origin/}"
  [ -n "$BASE" ] || BASE="$(git -C "$REPO_DIR" branch --show-current)"
  git -C "$REPO_DIR" fetch -q origin 2> /dev/null
  start="$BASE"
  git -C "$REPO_DIR" rev-parse -q --verify "origin/$BASE" > /dev/null 2>&1 && start="origin/$BASE"
  BRANCH="detroit/$(slug "$TASK_NAME")-$(date +%m%d%H%M%S)-$RANDOM"
  WORK="$PROJECTS/.detroit/$(basename "$REPO_DIR")-$(slug "$TASK_NAME")"
  [ -e "$WORK" ] && git -C "$REPO_DIR" worktree remove --force "$WORK" 2> /dev/null
  rm -rf "$WORK"
  mkdir -p "$(dirname "$WORK")"
  git -C "$REPO_DIR" worktree add -q -b "$BRANCH" "$WORK" "$start" || return 1
  export DETROIT_WORK="$WORK" DETROIT_BRANCH="$BRANCH"
}

plan() {
  local answer
  PLAN_FILE="$STATE/plans/$TASK_NAME.md"
  rm -f "$PLAN_FILE"
  export DETROIT_PLAN="$PLAN_FILE"
  run_agent "${DETROIT_PLAN_TIMEOUT:-300}" "Decide whether this task needs a written plan: yes for a new surface, more than one subsystem, a schema or behavior change or a new dependency; no for a small, clear change. If yes, write the plan to $PLAN_FILE. If no, write nothing. Do not change the repo or run git.

--- TASK ---
$TASK_BODY
--- END TASK ---" > /dev/null
  [ -s "$PLAN_FILE" ] || return 0
  log "plan written: $PLAN_FILE"
  [ "${DETROIT_APPROVE_PLAN:-0}" = 1 ] || return 0
  printf 'Approve plan %s and continue? [y/N] ' "$PLAN_FILE" > /dev/tty 2> /dev/null
  read -r answer < /dev/tty 2> /dev/null || answer=y
  case "$answer" in
    y | Y | yes) return 0 ;;
    *) log "plan rejected"; return 1 ;;
  esac
}

code() {
  local lessons="" plan="" prompt note="" attempt=1 max rc
  max=$((1 + ${DETROIT_RETRIES:-1}))
  [ -f "$LESSONS" ] && lessons="$(grep '^- ' "$LESSONS" | tail -15)"
  [ -s "$PLAN_FILE" ] && plan="$(cat "$PLAN_FILE")"
  prompt="$(
    cat << EOF
You are running under Detroit. Complete this task in the repo at $WORK (branch $BRANCH, base $BASE).

--- TASK ---
$TASK_BODY
--- END TASK ---
${plan:+
--- APPROVED PLAN (implement to this) ---
$plan
--- END PLAN ---
}${lessons:+
--- PAST LESSONS (avoid repeating these) ---
$lessons
--- END LESSONS ---
}
Garden checks every command, commit and push. Fix what it reports. When the work is committed, open the pull request with garden pr (see garden help).
EOF
  )"
  while [ "$attempt" -le "$max" ]; do
    LINE_ATTEMPT="$attempt"
    LINE_ACTIVITY="$(date +%s)"
    line_write
    run_agent "${DETROIT_CODE_TIMEOUT:-3600}" "$prompt$note"
    rc=$?
    [ "$rc" = 125 ] || return "$rc"
    log "restarting $TASK_NAME after a stall (attempt $attempt of $max)"
    note=$'\n\nYour previous attempt stalled and was stopped. Run git status and git log in the repo, then continue from where it stopped.'
    attempt=$((attempt + 1))
  done
  return 125
}

fail() {
  log "failed: $TASK_NAME: $1"
  printf -- '- %s: %s\n' "$TASK_NAME" "$1" >> "$LESSONS"
  mv "$TASK_FILE" "$TASKS/failed/"
  printf '%s failed %s %s\n' "$(date '+%F %T')" "$TASK_NAME" "$1" >> "$STATE/results.log"
  release
  return 1
}

finish() {
  local url issue repo num
  url="$(cd "$WORK" && gh pr list --head "$BRANCH" --state all --json url --jq '.[0].url' 2> /dev/null)"
  [ -n "$url" ] || { fail "the agent finished but no pull request exists for $BRANCH"; return 1; }
  issue="$(front "$TASK_FILE" issue)"
  if [ -n "$issue" ]; then
    repo="${issue%%#*}"
    num="${issue##*#}"
    gh issue comment "$num" --repo "$repo" --body "Pull request: $url" > /dev/null 2>&1
    gh issue close "$num" --repo "$repo" > /dev/null 2>&1
  fi
  mv "$TASK_FILE" "$TASKS/done/"
  git -C "$REPO_DIR" worktree remove --force "$WORK" 2> /dev/null
  printf '%s done %s %s\n' "$(date '+%F %T')" "$TASK_NAME" "$url" >> "$STATE/results.log"
  log "done: $TASK_NAME $url"
  release
}

run_one() {
  local rc
  pick_task || return 2
  TASK_LOG="$STATE/logs/$(date +%Y%m%d-%H%M%S)-$TASK_NAME.log"
  LINE_STARTED="$(date +%s)"
  LINE_ACTIVITY="$LINE_STARTED"
  LINE_ATTEMPT=1
  REPO_DIR=""
  BRANCH=""
  log "task: $TASK_NAME"
  phase setup
  setup || { fail "could not set up the repo and branch"; return 1; }
  phase plan
  plan || { fail "the plan was rejected or the planning step failed"; return 1; }
  phase code
  code
  rc=$?
  if [ "$rc" = 125 ]; then
    fail "the agent stalled on every attempt"
    return 1
  elif [ "$rc" != 0 ]; then
    fail "the agent run failed or timed out"
    return 1
  fi
  phase finish
  finish
}

cmd_run() {
  init
  preflight || return 1
  trap 'release; exit 130' INT TERM
  trap release EXIT
  run_one
  case $? in
    0) return 0 ;;
    2) log "no tasks in $TASKS"; return 2 ;;
    *) return 1 ;;
  esac
}

shift_worker() {
  local rc
  while [ "$(date +%s)" -lt "$SHIFT_END" ]; do
    run_one
    rc=$?
    if [ "$rc" = 2 ]; then
      log "shift: queue empty"
      return 0
    fi
    sleep "$SHIFT_PAUSE"
  done
}

cmd_shift() {
  local hours="${DETROIT_SHIFT_HOURS:-6}" parallel="${DETROIT_PARALLEL:-1}" before ran fails i
  SHIFT_PAUSE="${DETROIT_PAUSE:-30}"
  PIDS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --hours) hours="$2"; shift 2 ;;
      --parallel) parallel="$2"; shift 2 ;;
      *) usage >&2; return 2 ;;
    esac
  done
  case "$parallel" in
    "" | *[!0-9]* | 0) usage >&2; return 2 ;;
  esac
  init
  preflight || return 1
  trap 'kill "${PIDS[@]}" 2> /dev/null; release; exit 130' INT TERM
  trap release EXIT
  SHIFT_LOCK="$STATE/shift.lock"
  lock_take "$SHIFT_LOCK" || { log "another shift is running"; SHIFT_LOCK=""; return 0; }
  SHIFT_END=$(($(date +%s) + hours * 3600))
  before="$(cat "$STATE/results.log" 2> /dev/null | wc -l)"
  log "shift: agent $AGENT, up to ${hours}h, $parallel at a time"
  if [ "$parallel" -le 1 ]; then
    shift_worker
  else
    for i in $(seq "$parallel"); do
      (
        SHIFT_LOCK=""
        trap 'release; exit 130' INT TERM
        trap release EXIT
        shift_worker
      ) &
      PIDS+=("$!")
    done
    wait "${PIDS[@]}"
  fi
  ran="$(tail -n +$((before + 1)) "$STATE/results.log" 2> /dev/null | wc -l)"
  fails="$(tail -n +$((before + 1)) "$STATE/results.log" 2> /dev/null | grep -c ' failed ')"
  log "shift: finished, $ran ran, $fails failed"
}

cmd_add() {
  local repo="" name="" text="" base file n=2
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --name) name="$2"; shift 2 ;;
      *) text="${text:+$text }$1"; shift ;;
    esac
  done
  [ -n "$text" ] || { usage >&2; return 2; }
  init
  [ -n "$name" ] || name="$(printf '%s' "$text" | awk '{ print $1, $2, $3, $4, $5, $6 }')"
  base="$(slug "$name")"
  file="$TASKS/$base.md"
  while [ -e "$file" ]; do
    file="$TASKS/$base-$n.md"
    n=$((n + 1))
  done
  {
    [ -n "$repo" ] && printf -- '---\nrepo: %s\n---\n\n' "$repo"
    printf '%s\n' "$text"
  } > "$file"
  printf '%s\n' "$file"
}

esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

line_field() { sed -n "s/^$2=//p" "$1" | head -1; }

queue_count() { find "$TASKS" -maxdepth 1 -name '*.md' -type f | wc -l | tr -d ' '; }

shift_alive() { [ -f "$STATE/shift.lock/pid" ] && kill -0 "$(cat "$STATE/shift.lock/pid")" 2> /dev/null; }

fmt_secs() {
  local s="$1"
  if [ "$s" -ge 3600 ]; then
    printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
  elif [ "$s" -ge 60 ]; then
    printf '%dm%02ds' $((s / 60)) $((s % 60))
  else
    printf '%ds' "$s"
  fi
}

lines_rows() {
  local f now pid started activity idle state stall="${DETROIT_STALL_SECS:-900}"
  now="$(date +%s)"
  for f in "$LINES"/*; do
    [ -f "$f" ] || continue
    case "$f" in *.tmp) continue ;; esac
    pid="$(line_field "$f" pid)"
    started="$(line_field "$f" started)"
    activity="$(line_field "$f" activity)"
    [ -n "$activity" ] || activity="$started"
    idle=$((now - ${activity:-$now}))
    state=running
    if ! kill -0 "$pid" 2> /dev/null; then
      state=crashed
    elif [ "$idle" -ge "$stall" ]; then
      state=stalled
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(line_field "$f" task)" "$(line_field "$f" repo)" "$(line_field "$f" phase)" "$(line_field "$f" attempt)" "$((now - ${started:-$now}))" "$idle" "$state"
  done
}

render_text() {
  local rows total n=0 waiting task repo ph att el idle st
  rows="$(lines_rows)"
  total="$(queue_count)"
  [ -n "$rows" ] && n="$(printf '%s\n' "$rows" | wc -l | tr -d ' ')"
  waiting=$((total - n))
  [ "$waiting" -lt 0 ] && waiting=0
  printf 'DETROIT  %s   shift: %s   running: %s   waiting: %s\n\n' "$(date +%T)" "$(shift_alive && echo running || echo idle)" "$n" "$waiting"
  printf '%-24s %-16s %-8s %-4s %-9s %-9s %s\n' TASK REPO PHASE TRY ELAPSED IDLE STATE
  if [ -n "$rows" ]; then
    while IFS=$'\t' read -r task repo ph att el idle st; do
      printf '%-24s %-16s %-8s %-4s %-9s %-9s %s\n' "${task:0:24}" "${repo:0:16}" "$ph" "${att:-1}" "$(fmt_secs "$el")" "$(fmt_secs "$idle")" "$st"
    done <<< "$rows"
  else
    printf '(no lines running)\n'
  fi
  printf '\nrecent:\n'
  tail -n 5 "$STATE/results.log" 2> /dev/null | sed 's/^/  /'
}

render_json() {
  local rows total n=0 first=1 task repo ph att el idle st d t status name detail
  rows="$(lines_rows)"
  total="$(queue_count)"
  [ -n "$rows" ] && n="$(printf '%s\n' "$rows" | wc -l | tr -d ' ')"
  printf '{"time":%s,"queue":%s,"running":%s,"shift":%s,"stall_secs":%s,"lines":[' "$(date +%s)" "$total" "$n" "$(shift_alive && echo true || echo false)" "${DETROIT_STALL_SECS:-900}"
  if [ -n "$rows" ]; then
    while IFS=$'\t' read -r task repo ph att el idle st; do
      [ "$first" = 1 ] || printf ','
      first=0
      printf '{"task":"%s","repo":"%s","phase":"%s","attempt":%s,"elapsed":%s,"idle":%s,"state":"%s"}' "$(esc "$task")" "$(esc "$repo")" "$(esc "$ph")" "${att:-1}" "${el:-0}" "${idle:-0}" "$(esc "$st")"
    done <<< "$rows"
  fi
  printf '],"results":['
  first=1
  while read -r d t status name detail; do
    [ -n "$d" ] || continue
    [ "$first" = 1 ] || printf ','
    first=0
    printf '{"time":"%s %s","status":"%s","task":"%s","detail":"%s"}' "$d" "$t" "$(esc "$status")" "$(esc "$name")" "$(esc "$detail")"
  done < <(tail -n 10 "$STATE/results.log" 2> /dev/null)
  printf ']}\n'
}

cmd_status() {
  local running d pid
  init
  if [ "${1:-}" = "--json" ]; then
    render_json
    return 0
  fi
  printf 'queue: %s task(s) in %s\n' "$(queue_count)" "$TASKS"
  running=""
  for d in "$STATE"/locks/*/; do
    [ -f "${d}pid" ] || continue
    pid="$(cat "${d}pid")"
    kill -0 "$pid" 2> /dev/null && running="$running $(basename "$d")"
  done
  printf 'running:%s\n' "${running:- none}"
  if shift_alive; then
    printf 'shift: running\n'
  else
    printf 'shift: not running\n'
  fi
  printf 'last results:\n'
  tail -n 5 "$STATE/results.log" 2> /dev/null | sed 's/^/  /'
  return 0
}

cmd_dash() {
  local once=0 web=0 port=8787 interval=2 dir writer server
  while [ $# -gt 0 ]; do
    case "$1" in
      --once) once=1; shift ;;
      --web) web=1; shift ;;
      --port) port="$2"; shift 2 ;;
      --interval) interval="$2"; shift 2 ;;
      *) usage >&2; return 2 ;;
    esac
  done
  init
  if [ "$web" = 1 ]; then
    command -v python3 > /dev/null || { log "python3 is needed to serve the web dashboard."; return 1; }
    dir="$STATE/web"
    mkdir -p "$dir"
    cp "$DETROIT_HOME/web/dashboard.html" "$dir/index.html"
    render_json > "$dir/status.json"
    (
      while :; do
        render_json > "$dir/status.json.tmp" && mv "$dir/status.json.tmp" "$dir/status.json"
        sleep "$interval"
      done
    ) &
    writer=$!
    python3 -m http.server "$port" --bind 127.0.0.1 --directory "$dir" > /dev/null 2>&1 &
    server=$!
    trap 'kill "$writer" "$server" 2> /dev/null' EXIT
    trap 'exit 0' INT TERM
    printf 'dashboard: http://127.0.0.1:%s\n' "$port"
    wait "$server"
    return 0
  fi
  if [ "$once" = 1 ]; then
    render_text
    return 0
  fi
  trap 'printf "\033[?25h"; exit 0' INT TERM
  printf '\033[?25l'
  while :; do
    printf '\033[H\033[2J'
    render_text
    sleep "$interval"
  done
}

cmd_install() {
  local dir="${DETROIT_UNIT_DIR:-$HOME/.config/systemd/user}" bin="$DETROIT_HOME/bin/detroit"
  mkdir -p "$dir" "$STATE"
  cat > "$dir/detroit-nightly.service" << EOF
[Unit]
Description=Detroit nightly shift

[Service]
Type=oneshot
Environment=PATH=$PATH
ExecStart=$bin shift
StandardOutput=append:$STATE/nightly.log
StandardError=append:$STATE/nightly.log
TimeoutStartSec=8h
TimeoutStopSec=30s
EOF
  cat > "$dir/detroit-nightly.timer" << 'EOF'
[Unit]
Description=Detroit nightly shift at 01:00

[Timer]
OnCalendar=*-*-* 01:00:00

[Install]
WantedBy=timers.target
EOF
  systemctl --user daemon-reload && systemctl --user enable --now detroit-nightly.timer
}

cmd_uninstall() {
  local dir="${DETROIT_UNIT_DIR:-$HOME/.config/systemd/user}"
  systemctl --user disable --now detroit-nightly.timer 2> /dev/null
  rm -f "$dir/detroit-nightly.service" "$dir/detroit-nightly.timer"
  systemctl --user daemon-reload
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  run) cmd_run "$@" ;;
  shift) cmd_shift "$@" ;;
  add) cmd_add "$@" ;;
  status) cmd_status "$@" ;;
  dash) cmd_dash "$@" ;;
  install) cmd_install "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
esac
